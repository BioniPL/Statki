<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Statki.MainWindow"
        Title="Statki"
        KeyDown="Sterowanie_Gracza"
        KeyUp="Zatrzymanie_Gracza"
>

        <Grid>
                <Canvas x:Name="Mapa_Gry" IsVisible="True">
                        <Image x:Name="Gracz" Source="/Assets/gracz/south0.png" Width="50" Height="50" Canvas.Top="100" Canvas.Left="100"/>
                        <Image x:Name="Bandyta" Source="/Assets/bandyta/bandyta0.png" Width="50" Height="50" Canvas.Top="200" Canvas.Left="300"/>
                        <TextBlock x:Name="StatystykiGraczaNaSwiecie" Text="test" FontSize="20" HorizontalAlignment="Center"/>
                </Canvas>
                

                <Grid x:Name="Walka_GUI" IsVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <TextBlock x:Name="OpisWalki" Text="Walka!" FontSize="20" HorizontalAlignment="Center"/>
                                <Button Content="Ucieczka" Click="Ucieczka"/>
                                <Button Content="Lekki Atak" Click="Lekki_Atak"/>
                                <Button Content="Średni Atak" Click="Sredni_Atak"/>
                                <Button Content="Mocny Atak" Click="Mocny_Atak"/>
                        </StackPanel>
                </Grid>
        </Grid>
        
    
</Window>
